APP_NAME=SIGMA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sigma
DB_USERNAME=sigma
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Enlace seguro de inserción de Power BI (no utilizar "Publicar en la web").
POWER_BI_EMBED_URL=

# GLPI 10 Legacy REST API. Use HTTPS and a dedicated least-privilege API account.
GLPI_ENABLED=false
GLPI_BASE_URL=https://glpi.example.edu/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_ENTITY_ID=0
GLPI_TICKET_TYPE=2
GLPI_CATEGORY_TECHNICAL_SERVICE=
GLPI_CATEGORY_ASSET_MOVEMENT=
GLPI_CATEGORY_MAINTENANCE_SCHEDULE=
# At least one assignment target is required: map SIGMA technician email to GLPI user ID,
# or set a fallback GLPI group ID. Example user map: {"tecnico@usc.edu.co":123}
GLPI_DEFAULT_GROUP_ID=
GLPI_USER_MAP={}
GLPI_CONNECT_TIMEOUT=5
GLPI_TIMEOUT=20
GLPI_VERIFY_TLS=true

# Sigma Agent release metadata. Store the ZIP in storage/app/agent-updates/.
SIGMA_AGENT_UPDATE_BASE_URL=http://172.16.161.81:8000
SIGMA_AGENT_UPDATE_VERSION=
SIGMA_AGENT_UPDATE_PACKAGE=
SIGMA_AGENT_UPDATE_SHA256=
SIGMA_AGENT_UPDATE_MANDATORY=false
SIGMA_AGENT_UPDATE_NOTES=

# Mantener en true solo durante la migración de agentes al token individual por activo.
SIGMA_AGENT_ALLOW_LEGACY_TOKENS=true

# RustDesk OSS local. Mantén estos puertos en loopback salvo que se apruebe acceso LAN.
RUSTDESK_SERVER_IMAGE=rustdesk/rustdesk-server:latest
RUSTDESK_BIND_ADDRESS=127.0.0.1
RUSTDESK_RELAY_HOST=127.0.0.1
